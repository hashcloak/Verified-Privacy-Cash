["skip",0]}]},{"key":{"Type":2},"value":[{"Ident":["ExtDataMinified",0]}]},{"key":{"Type":65},"value":[{"Ident":["FlatMap",0]}]},{"key":{"TraitDecl":9},"value":[{"Ident":["Into",0]}]},{"key":{"Type":56},"value":[{"Ident":["FilterMap",0]}]},{"key":{"TraitDecl":18},"value":[{"Ident":["Iterator",0]}]},{"key":{"Type":13},"value":[{"Ident":["ErrorOrigin",0]}]},{"key":{"TraitDecl":6},"value":[{"Ident":["PartialOrd",0]}]},{"key":{"Fun":164},"value":[{"Ident":["scan",0]}]},{"key":{"Type":19},"value":[{"Ident":["FrShim",0]}]},{"key":{"Fun":182},"value":[{"Ident":["all",0]}]},{"key":{"Fun":163},"value":[{"Ident":["take",0]}]},{"key":{"Fun":188},"value":[{"Ident":["rposition",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Ident":["zkcash",0]},{"Ident":["MerkleTreeAccount",0]}],"span":{"data":{"file_id":0,"beg":{"line":1087,"col":0},"end":{"line":1100,"col":1}},"generated_from_span":null},"source_text":"pub struct MerkleTreeAccount {\n    pub authority: Pubkey,\n    pub next_index: u64,\n    pub subtrees: [[u8; 32]; MERKLE_TREE_HEIGHT as usize],\n    pub root: [u8; 32],\n    pub root_history: [[u8; 32]; 100],\n    pub root_index: u64,\n    pub max_deposit_amount: u64,\n    pub height: u8,\n    pub root_history_size: u8,\n    pub bump: u8,\n    // The pub _padding: [u8; 5] is needed because of the #[account(zero_copy)] attribute.\n    pub _padding: [u8; 5],\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":0,"beg":{"line":1088,"col":4},"end":{"line":1088,"col":25}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"authority","ty":{"Deduplicated":1030}},{"span":{"data":{"file_id":0,"beg":{"line":1089,"col":4},"end":{"line":1089,"