  Result ((core.result.Result Std.Usize std.io.error.Error) × (alloc.vec.Vec Std.U8)) :=
  if h : v.length + s.length ≤ Usize.max then
    ok (.Ok (Slice.len s), ⟨ v.val ++ s.val, by simp; scalar_tac ⟩)
  else fail .panic

