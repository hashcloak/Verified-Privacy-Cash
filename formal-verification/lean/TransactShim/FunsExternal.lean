/-! ### Helpers for the DERIVED serialization definitions below.
    These have no Rust counterpart of their own -- they exist so that the borsh instances can
    be written once and read easily. -/

/-- The low byte of a natural number. -/
def byteOfNat (n : Nat) : Std.U8 :=
  Std.U8.ofNatCore (n % 256)
    (by have : n % 256 < 256 := Nat.mod_lt _ (by norm_num); simpa using this)

/-- `w`-byte LITTLE-ENDIAN expansion of `n` (least-significant byte first), which is the
    encoding borsh uses for every fixed-width integer. Machine-checked against
    `u64 1 = [1,0,0,0,0,0,0,0]`, `u64 256 = [0,1,0,...]`, `u64 2^63 = [0,...,0,128]`,
    `i64 (-1) = [255]*8` and `i64 MIN = [0,...,0,128]`. -/
def leBytes (w : Nat) (n : Nat) : List Std.U8 :=
  (List.range w).map (fun i => byteOfNat (n / 256 ^ i))

/-- Push a whole byte list through any `std::io::Write`. -/
def wrBytes {W : Type} (inst : std.io.Write W) (l : List Std.U8) (w : W)
    (h : l.length ≤ Usize.max := by scalar_tac) :
    Result ((core.result.Result Unit std.io.error.Error) × W) := do
  let (r, w') ← inst.write w ⟨ l, h ⟩
  match r with
  | .Ok _ => ok (.Ok (), w')
  | .Err e => ok (.Err e, w')

/-- borsh-serialize every element of a list in order, stopping at the first error. -/
def borshSerList {T W : Type} (einst : borsh.ser.BorshSerialize T) (winst : std.io.Write W) :
    List T → W → Result ((core.result.Result Unit std.io.error.Error) × W)
  | [], w => ok (.Ok (), w)
  | t :: ts, w => do
    let (r, w') ← einst.serialize winst t w
    match r with
    | .Ok _ => borshSerList einst winst ts w'
    | .Err e => ok (.Err e, w')

