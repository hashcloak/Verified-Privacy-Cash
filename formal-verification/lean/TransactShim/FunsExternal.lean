/-- DERIVED. borsh `i64`: 8 bytes little-endian, TWO'S COMPLEMENT -- i.e. the little-endian
    encoding of `x mod 2^64`. Counterpart of `i64LE` in Spec/privacy_cash_spec.lean, which
    spells the reduction the same way. This is the encoding `ext_amount` goes through, so a
    sign-handling error here would silently change what the ext-data hash commits to. -/
@[rust_fun "borsh::ser::{borsh::ser::BorshSerialize<i64>}::serialize"]
def I64.Insts.BorshSerBorshSerialize.serialize
  {W : Type} (stdioWriteInst : std.io.Write W) (x : Std.I64) (w : W) :
  Result ((core.result.Result Unit std.io.error.Error) × W) :=
  wrBytes stdioWriteInst (leBytes 8 (x.val % (2^64 : Int)).toNat) w (by simp [leBytes]; scalar_tac)

/-- DERIVED. borsh `u64`: 8 bytes little-endian. Counterpart of `u64LE` in
    Spec/privacy_cash_spec.lean -- relating the two is a one-line lemma, which is the whole
    point of deriving this rather than assuming it. -/
@[rust_fun "borsh::ser::{borsh::ser::BorshSerialize<u64>}::serialize"]
def U64.Insts.BorshSerBorshSerialize.serialize
  {W : Type} (stdioWriteInst : std.io.Write W) (x : Std.U64) (w : W) :
  Result ((core.result.Result Unit std.io.error.Error) × W) :=
  wrBytes stdioWriteInst (leBytes 8 x.val) w (by simp [leBytes]; scalar_tac)

/-- DERIVED. borsh `Vec<T>`: a 4-byte little-endian element COUNT, then each element in order.
    Counterpart of `vecU8` in Spec/privacy_cash_spec.lean. That length prefix is what makes the
    two encrypted outputs unambiguous inside the ext-data hash preimage -- without it, a byte
    could be moved from the end of one to the start of the next without changing the digest. -/
@[rust_fun
  "borsh::ser::{borsh::ser::BorshSerialize<alloc::vec::Vec<@T>>}::serialize"]
def alloc.vec.Vec.Insts.BorshSerBorshSerialize.serialize
  {T : Type} {W : Type} (BorshSerializeInst : borsh.ser.BorshSerialize T)
  (stdioWriteInst : std.io.Write W) (v : alloc.vec.Vec T) (w : W) :
  Result ((core.result.Result Unit std.io.error.Error) × W) := do
  let (r, w') ← wrBytes stdioWriteInst (leBytes 4 v.length) w (by simp [leBytes]; scalar_tac)
  match r with
  | .Ok _ => borshSerList BorshSerializeInst stdioWriteInst v.val w'
  | .Err e => ok (.Err e, w')

