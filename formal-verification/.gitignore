# Compilation artifacts for the Charon/Aeneas -> Lean pipeline.
# (vendor/ and target-patched/ are already ignored in the repo-root .gitignore.)

# Lean build outputs + Lake-fetched dependencies (Mathlib, Aeneas lib, etc.) -- huge.
lean/.lake/

# Fr diagnostic output written by `extract.sh --diagnose-fr` (charon logs + .llbc).
diagnostics/

# Generated by `nix print-dev-env path:. > devenv.sh` (see SETUP.md's Linux notes).
devenv.sh

# Toolchain / build logs (e.g. nix-build.log).
*.log

# nix build result symlinks (only created by `nix build`, not `nix develop`).
result
result-*

# NOTE: intentionally NOT ignored (these are project source/config, keep them tracked):
#   lakefile.toml, lean-toolchain, lake-manifest.json  -- the Lake project definition
#   lean/**/*.llbc, lean/**/{Types,Funs,*_Template}.lean -- the generated model
