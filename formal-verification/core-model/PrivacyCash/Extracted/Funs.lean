def admin.update_global_config
  (global_config : admin.GlobalConfig) (deposit_fee_rate : Option Std.U16)
  (withdrawal_fee_rate : Option Std.U16) (fee_error_margin : Option Std.U16) :
  Result ((core.result.Result Unit error.ErrorCode) × admin.GlobalConfig)
  := do
  match deposit_fee_rate with
  | none =>
    match withdrawal_fee_rate with
    | none =>
      match fee_error_margin with
      | none => ok (core.result.Result.Ok (), global_config)
      | some fee_error_margin_val =>
        if fee_error_margin_val <= admin.MAX_BASIS_POINTS
        then
          ok (core.result.Result.Ok (),
            { global_config with fee_error_margin := fee_error_margin_val })
        else
          ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
            global_config)
    | some withdrawal_rate =>
      if withdrawal_rate <= admin.MAX_BASIS_POINTS
      then
        match fee_error_margin with
        | none =>
          ok (core.result.Result.Ok (),
            { global_config with withdrawal_fee_rate := withdrawal_rate })
        | some fee_error_margin_val =>
          if fee_error_margin_val <= admin.MAX_BASIS_POINTS
          then
            ok (core.result.Result.Ok (),
              {
                global_config
                  with
                  withdrawal_fee_rate := withdrawal_rate,
                  fee_error_margin := fee_error_margin_val
              })
          else
            ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
              { global_config with withdrawal_fee_rate := withdrawal_rate })
      else
        ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
          global_config)
  | some deposit_rate =>
    if deposit_rate <= admin.MAX_BASIS_POINTS
    then
      match withdrawal_fee_rate with
      | none =>
        match fee_error_margin with
        | none =>
          ok (core.result.Result.Ok (),
            { global_config with deposit_fee_rate := deposit_rate })
        | some fee_error_margin_val =>
          if fee_error_margin_val <= admin.MAX_BASIS_POINTS
          then
            ok (core.result.Result.Ok (),
              {
                global_config
                  with
                  deposit_fee_rate := deposit_rate,
                  fee_error_margin := fee_error_margin_val
              })
          else
            ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
              { global_config with deposit_fee_rate := deposit_rate })
      | some withdrawal_rate =>
        if withdrawal_rate <= admin.MAX_BASIS_POINTS
        then
          match fee_error_margin with
          | none =>
            ok (core.result.Result.Ok (),
              {
                global_config
                  with
                  deposit_fee_rate := deposit_rate,
                  withdrawal_fee_rate := withdrawal_rate
              })
          | some fee_error_margin_val =>
            if fee_error_margin_val <= admin.MAX_BASIS_POINTS
            then
              ok (core.result.Result.Ok (),
                {
                  global_config
                    with
                    deposit_fee_rate := deposit_rate,
                    withdrawal_fee_rate := withdrawal_rate,
                    fee_error_margin := fee_error_margin_val
                })
            else
              ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
                {
                  global_config
                    with
                    deposit_fee_rate := deposit_rate,
                    withdrawal_fee_rate := withdrawal_rate
                })
        else
          ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate,
            { global_config with deposit_fee_rate := deposit_rate })
    else
      ok (core.result.Result.Err error.ErrorCode.InvalidFeeRate, global_config)

