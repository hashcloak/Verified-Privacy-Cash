    let pairing_input2 ← groth16.copy_into pairing_input1 64#usize proof_b
    let pairing_input3 ← groth16.copy_into pairing_input2 192#usize p
    let pairing_input4 ←
      groth16.copy_into pairing_input3 256#usize verifyingkey.vk_gamme_g2
    let pairing_input5 ← groth16.copy_into pairing_input4 384#usize proof_c
    let pairing_input6 ←
