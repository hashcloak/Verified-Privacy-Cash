    | none => true).map (·.1)

#guard fromBytesMismatches = []

/-- Operation vectors where the model and arkworks disagree. -/
def opMismatches : List (Nat × Nat) :=
  (opVectors.filter fun (a, b, add, sub, neg, le, eq) =>
    let (fa, fb) : Fr × Fr := (a, b)
    a ≥ bn254ScalarModulus || b ≥ bn254ScalarModulus ||
    frVal (arkFr.add fa fb) != some add || frVal (arkFr.sub fa fb) != some sub ||
    frVal (arkFr.neg fa) != some neg ||
    Option.ofResult (arkFr.le fa fb) != some le || Option.ofResult (arkFr.eq fa fb) != some eq
  ).map fun (a, b, _) => (a, b)

#guard opMismatches = []

end PrivacyCash.Tests
