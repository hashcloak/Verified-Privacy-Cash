/-- A hex digit's value. -/
def hexDigit (c : Char) : Nat :=
  if '0' ≤ c ∧ c ≤ '9' then c.toNat - '0'.toNat
  else if 'a' ≤ c ∧ c ≤ 'f' then c.toNat - 'a'.toNat + 10 else 0

def byte (n : Nat) : U8 := U8.ofNatCore (n % 256) (by simp only [UScalarTy.numBits]; omega)

def bytes (s : String) : List U8 :=
  let ds := s.toList.map hexDigit
  (List.range (ds.length / 2)).map fun i => byte (16 * ds[2 * i]! + ds[2 * i + 1]!)

def array64? (s : String) : Option (Std.Array U8 64#usize) :=
  let l := bytes s
  if h : l.length = 64 then some (Std.Array.from l h) else none

/-- The model's answer for `alt_bn128_addition(b ‖ 0)`: the decoded point,
    re-encoded big-endian (the identity as zeros), or failure. -/
def modelAddZero (b : Std.Array U8 64#usize) : Option (List U8) :=
  (syscallDecodeG1 b).map fun P => reverseHalves P.toBytes.val

#guard g1DecodeVectors.length = 37

/-- The vectors where the model and solana-bn254 disagree. -/
def g1DecodeMismatches : List String :=
  (g1DecodeVectors.filter fun (_, input, expected) =>
    match array64? input with
    | some b => modelAddZero b != expected.map bytes
    | none => true).map (·.1)

#guard g1DecodeMismatches = []

end PrivacyCash.Tests.G1Decode
