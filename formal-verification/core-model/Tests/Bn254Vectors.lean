/-- A byte list as a 64-byte array, if it has 64 bytes all below 256. -/
def array64? (l : List Nat) : Option (Std.Array U8 64#usize) :=
  if h : l.length = 64 ∧ ∀ n ∈ l, n < 256 then
    some (Std.Array.from (l.attach.map fun ⟨n, hn⟩ => U8.ofNatCore n (by
      have := h.2 n hn; simp only [UScalarTy.numBits]; omega)) (by simp [h.1]))
  else none

/-- The model's answer on a vector's input, as plain numbers; `none` if the
    model errors or the input is malformed. -/
def modelNegateG1 (input : List Nat) : Option (Option (List Nat)) := do
  let a ← array64? input
  let r ← Option.ofResult (negateG1 a)
  pure (r.map fun out => out.val.map (·.val))

#guard negateG1Vectors.length = 39

/-- The descriptions of the vectors where the model and arkworks disagree. -/
def negateG1Mismatches : List String :=
  (negateG1Vectors.filter fun (_, input, expected) => modelNegateG1 input != some expected).map (·.1)

#guard negateG1Mismatches = []

